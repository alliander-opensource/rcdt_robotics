<sdf version="1.6">
  <world name="test_table_openvla">

    <!-- Physics -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Systems -->
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ========================= -->
    <!-- TABLE (STATIC, PREBUILT) -->
    <!-- ========================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/table</uri>
      <name>table</name>
      <pose>0.7 0 0 0 0 1.57</pose>
      <static>true</static>
    </include>

    <!-- ========================= -->
    <!-- BIN / BASKET (DYNAMIC OBJECT) -->
    <!-- ========================= -->
    <model name="basket">
      <pose>0.8 -0.6 1 0 0 0</pose>
      <static>false</static>
      <include>
        <uri>
        https://fuel.gazebosim.org/1.0/GoogleResearch/models/Target_Basket_Medium
        </uri>
      </include>
    </model>

    <!-- ========================= -->
    <!-- CUP (DYNAMIC OBJECT) -->
    <!-- ========================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/GoogleResearch/models/Threshold_Porcelain_Coffee_Mug_All_Over_Bead_White</uri>
      <name>white_cup</name>
      <!-- Adjust Z so it sits on table -->
      <pose>0.5 0.4 1 0 0 0</pose>
      <static>false</static>
    </include>

    <!-- ========================= -->
    <!-- LIGHT -->
    <!-- ========================= -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ========================= -->
    <!-- GROUND -->
    <!-- ========================= -->
    <model name="ground_plane">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>

